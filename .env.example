# Settings the engine (services/orchestrator) reads from its environment.
# Copy to .env, which the engine loads from its working directory or up to two
# directories above it; variables already set in the environment win.
#
# Everything else is configured in a TOML file: see
# services/orchestrator/config.example.toml, and ORCHER_ORCHESTRATOR_CONFIG
# below. Each variable here overrides its counterpart in that file.

# PostgreSQL, the only datastore the engine needs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orcher

# Configuration file (also --config).
# ORCHER_ORCHESTRATOR_CONFIG=services/orchestrator/config.example.toml

# Where the gRPC API and the HTTP health/metrics endpoint listen
# (also --grpc-addr, --http-addr). The defaults are this machine only.
# GRPC_BIND_ADDR=127.0.0.1:50051
# HTTP_BIND_ADDR=127.0.0.1:8080

# Serving the gRPC API without authentication on an address other machines
# can reach is refused unless this is set (also --insecure): anyone who can
# connect can start, cancel and read every workflow. Set [security] auth_mode
# in the configuration file instead for anything shared.
# ORCHER_INSECURE=true

# Logging (also --log-level, --log-format): level is trace, debug, info, warn
# or error; format is compact, json or pretty.
# LOG_LEVEL=info
# LOG_FORMAT=compact

# Database connections this engine holds. Several engines sharing one
# PostgreSQL must fit under its max_connections together.
# ORCHER_PG_MAX_CONNECTIONS=80
# ORCHER_PG_MIN_CONNECTIONS=20

# Running several engines as one cluster. A node's id defaults to its gRPC
# bind address.
# ORCHER_CLUSTER_ENABLED=true
# ORCHER_NODE_ID=node-1

# The database the integration tests use (cargo test -- --ignored).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orcher_test
