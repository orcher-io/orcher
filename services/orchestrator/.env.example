# ORCHER Orchestrator Environment Variables
# Copy to .env for local development

# ============================================
# Database Configuration
# ============================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orcher

# Optional: Redis URL for caching and queues
REDIS_URL=redis://localhost:6379

# ============================================
# Server Configuration
# ============================================

# gRPC server address (for Service/client connections)
GRPC_BIND_ADDR=0.0.0.0:50051

# HTTP server address (for health checks and metrics)
HTTP_BIND_ADDR=0.0.0.0:8001

# Maximum concurrent gRPC streams
MAX_CONCURRENT_STREAMS=1000

# ============================================
# Service Execution Polling Configuration
# ============================================

# How long a Service can hold a claim before it expires (seconds)
# Default: 300 (5 minutes)
ORCHER_CLAIM_TIMEOUT_SECS=300

# How long to wait when polling for work (seconds)
# Default: 60 (1 minute)
ORCHER_POLL_TIMEOUT_SECS=60

# How often to check for and reclaim expired claims (seconds)
# Default: 10 (10 seconds)
ORCHER_RECLAIM_INTERVAL_SECS=10

# Enable notification-based wake-ups for efficient polling
# When enabled, Services wake up in <100ms vs 60s poll timeout
# Default: true
ORCHER_ENABLE_NOTIFICATIONS=true

# ============================================
# Orchestrator Configuration
# ============================================

# Maximum concurrent workflow executions
MAX_WORKERS=100

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=1000

# Worker heartbeat timeout (seconds)
HEARTBEAT_TIMEOUT_SECS=90

# Enable Prometheus metrics
ENABLE_METRICS=true

# Default workflow execution timeout (seconds)
DEFAULT_WORKFLOW_TIMEOUT_SECS=3600

# ============================================
# Logging Configuration
# ============================================

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Log format: json | compact | pretty
LOG_FORMAT=pretty

# Enable ANSI colors in logs (disable for production)
LOG_COLORS=true

# ============================================
# Queue Configuration (Optional)
# ============================================

# Enable queue-based task dispatch
# QUEUE_ENABLED=false

# Dispatch strategy: direct | queue | hybrid
# DISPATCH_STRATEGY=direct

# Queue provider: inmemory | redis | rabbitmq | postgres | sqs | kafka
# QUEUE_PROVIDER=redis

# ============================================
# Event Consumer Configuration (Optional)
# ============================================

# Enable event consumer for external events
# EVENT_CONSUMER_ENABLED=false

# Maximum concurrent event processors
# EVENT_CONSUMER_MAX_CONCURRENT=50

# Poll interval for queue (seconds)
# EVENT_CONSUMER_POLL_INTERVAL_SECS=1

# ============================================
# Health Check Configuration
# ============================================

# Enable readiness checks
READINESS_ENABLED=true

# Enable liveness checks
LIVENESS_ENABLED=true

# ============================================
# Development/Testing
# ============================================

# Rust log level (overrides LOG_LEVEL)
# RUST_LOG=info,orcher_orchestrator=debug

# Enable Rust backtrace on panic
# RUST_BACKTRACE=1

# Disable TLS for local development
# ORCHER_DISABLE_TLS=true
